# Copy to .env and edit. All values shown are the defaults.
GERMES_WAKE_WORD=гермес
GERMES_MODEL_DIR=models/vosk-model-small-ru-0.22
GERMES_TTS_VOICE=ru-RU-DmitryNeural
GERMES_TTS_RATE=+20%
GERMES_BRAIN_CMD=hermes -z {prompt} --yolo
GERMES_BRAIN_TIMEOUT=60
GERMES_INPUT_DEVICE=
GERMES_RMS_VOICE_THRESHOLD=350
GERMES_LOG_LEVEL=INFO
