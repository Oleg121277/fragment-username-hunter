# Куда складывать кеш распакованной Vosk-модели. По умолчанию — models/ внутри проекта.
GERMES_MODEL_DIR=models/vosk-model-small-ru-0.22
# Ключевое слово (слушаем поток Vosk, ищем подстроку в partial/final).
GERMES_WAKE_WORD=гермес
# Голос для edge-tts (ru-RU, женский по умолчанию).
GERMES_TTS_VOICE=ru-RU-SvetlanaNeural
# Команда мозга (Hermes). Поддерживает плейсхолдер {prompt}.
GERMES_BRAIN_CMD=hermes -z "{prompt}" --yolo
# Уровень логирования: INFO, DEBUG, WARNING.
GERMES_LOG_LEVEL=INFO
# Имя устройства ввода (оставьте пустым, чтобы взять устройство по умолчанию).
GERMES_INPUT_DEVICE=
